{
  "datasets": [
    {
      "name": "2f1c7c0d",
      "displayName": "Q1 Activation",
      "queryLines": [
        "SELECT\n",
        "  market_segment,\n",
        "  COUNT(*)                                         AS total_customers,\n",
        "  SUM(CASE WHEN is_activated THEN 1 ELSE 0 END)    AS activated_customers,\n",
        "  AVG(CASE WHEN is_activated THEN 1.0 ELSE 0 END)  AS activation_rate\n",
        "FROM workspace.marketing_gold.customer_marketing\n",
        "GROUP BY market_segment\n",
        "ORDER BY market_segment;"
      ]
    },
    {
      "name": "1462a29a",
      "displayName": "Q2 New customers 1996-Q1",
      "queryLines": [
        "SELECT month, new_customers\n",
        "FROM workspace.marketing_gold.monitoring_new_customers_monthly\n",
        "WHERE quarter = '1996-Q1'\n",
        "ORDER BY month;"
      ]
    },
    {
      "name": "40750e29",
      "displayName": "Q3 Repeat purchase",
      "queryLines": [
        "SELECT market_segment, total_customers, repeat_customers, repeat_purchase_rate\n",
        "FROM workspace.marketing_gold.repeat_purchase_rate_by_segment\n",
        "ORDER BY repeat_purchase_rate DESC;"
      ]
    },
    {
      "name": "65fdab85",
      "displayName": "Q4 Cohort retention",
      "queryLines": [
        "SELECT cohort, cohort_customers, returned_customers, retention_rate\n",
        "FROM workspace.marketing_gold.cohort_retention_1996\n",
        "ORDER BY cohort;"
      ]
    },
    {
      "name": "2d26367e",
      "displayName": "Activation over time",
      "queryLines": [
        "SELECT month, market_segment, activation_rate, change_pp, is_alert\n",
        "FROM workspace.marketing_gold.monitoring_activation_rate_by_segment\n",
        "ORDER BY month, market_segment;"
      ]
    },
    {
      "name": "6dcd97e4",
      "displayName": "New customers over time",
      "queryLines": [
        "SELECT month, quarter, new_customers, trailing_avg, is_alert\n",
        "FROM workspace.marketing_gold.monitoring_new_customers_monthly\n",
        "ORDER BY month;"
      ]
    },
    {
      "name": "0b22d9b2",
      "displayName": "Alerts",
      "queryLines": [
        "SELECT month, 'activation_rate_drop' AS alert, market_segment AS scope,\n",
        "       CAST(ROUND(change_pp, 2) AS STRING) AS detail\n",
        "FROM workspace.marketing_gold.monitoring_activation_rate_by_segment\n",
        "WHERE is_alert\n",
        "UNION ALL\n",
        "SELECT month, 'new_customers_drop', 'ALL',\n",
        "       CONCAT(CAST(new_customers AS STRING), ' vs avg ', CAST(ROUND(trailing_avg, 1) AS STRING))\n",
        "FROM workspace.marketing_gold.monitoring_new_customers_monthly\n",
        "WHERE is_alert\n",
        "ORDER BY month DESC;"
      ]
    }
  ],
